# Documentation:
# https://direnv.net/man/direnv-stdlib.1.html

PROJECT_NAME="Bonsai"

t_init="$(date +%s%3N)"

# Color codes (256-color xterm palette)
GREEN='\033[38;5;114m'     # #87d787 soft green
YELLOW='\033[38;5;214m'    # #ffaf00 amber
RED='\033[38;5;203m'       # #ff5f5f soft red
BLUE='\033[38;5;75m'       # #5fafff sky blue
CYAN='\033[38;5;80m'       # #5fd7d7 soft cyan
ORANGE='\033[38;5;208m'    # #ff8700 orange
PURPLE='\033[38;5;177m'    # #d787ff soft purple
GRAY_DIM='\033[38;5;238m'  # #444444 for perf labels
GRAY='\033[38;5;245m'      # #8a8a8a for perf brackets
BOLD='\033[1m'
NC='\033[0m' # No color


log_elapsed() {
  local end="$(date +%s%3N)"
  local diff=$((end - $2))
  local ms=$((diff % 1000)) s=$((diff / 1000 % 60)) m=$((diff / 60000))

  local t="${ms}ms"
  [ $s -gt 0 ] && t="${s},${t}"
  [ $m -gt 0 ] && t="${m}m ${t}"

  printf "⏱️  ${GRAY}${t} ${GRAY_DIM}$1${NC}\n" >&2
  printf '%s\n' "$end"
}


load_env_file() {
  if [[ -f $1 ]] ; then
    # Unset existing variables, allowing them to be overridden
    unset $(grep -v '^#' "$1" | sed -E 's/=.*//')
    # Load 1password-compatible .env file
    # https://github.com/venkytv/direnv-op/blob/db976ce107a2f58fb7465a7d2f0858a37b32e1f1/oprc.sh
    direnv_load op run --env-file "$1" --no-masking -- direnv dump
    watch_file $1
    printf "💉  ${GREEN}$1 ${NC}loaded ${NC}\n"
  fi
}


# Load env files in dotenv-flow cascade order (later files take precedence).
load_env_files() {
  load_env_file .env
  load_env_file .env.local
}

export NO_COLOR=1

# Load system dependencies from Nix
strict_env
layout node
t_section="$(log_elapsed "setup boot" "$t_init")"
use nix
t_section="$(log_elapsed "use nix" "$t_section")"


PATH_add scripts

load_env_files
t_section="$(log_elapsed "load env files" "$t_section")"


t_total="$(log_elapsed "${GRAY}in total" "$t_init")"
printf "\n\n${GREEN}${BOLD}❯${NC} Welcome to the ${GREEN}${BOLD}${PROJECT_NAME}${NC} shell!\n\n"
unset NO_COLOR
