{
  "name": "@jiggy/bonsai",
  "version": "0.1.0",
  "private": true,
  "description": "Deliberate growth. Continuous pruning. A contract-rooted code budget gate.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "bin": {
    "bonsai": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "bonsai": "bun src/cli.ts",
    "demo": "bun src/cli.ts check --root examples/checkout",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@cucumber/gherkin": "^37.0.0",
    "@cucumber/messages": "^32.0.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@biomejs/biome": "2.5.12"
  },
  "packageManager": "bun@1.4.3"
}