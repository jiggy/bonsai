{
  "name": "@jigging/bonsai",
  "version": "0.0.0-alpha.1",
  "description": "Deliberate growth. Continuous pruning. A contract-rooted code budget gate.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "bin": {
    "bonsai": "src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test --isolate --timeout 30000",
    "bonsai": "bun src/cli.ts",
    "demo": "bun src/cli.ts check --root examples/checkout",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:features": "bun test --timeout 60000 test/self-host.test.ts",
    "test:specs": "bun test/specs.ts",
    "test:spec-sensitivity": "bun test --isolate --timeout 60000 test/spec-sensitivity.test.ts",
    "test:package": "BONSAI_PACKAGE_SMOKE=1 bun test --timeout 180000 test/package-install.test.ts",
    "website:build": "bun website/build.mjs",
    "website:check": "bun website/check.mjs",
    "native:compare": "bun native/tools/compare.ts",
    "native:bench": "bun native/tools/bench.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "^37.0.0",
    "ignore": "^7.0.13",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@biomejs/biome": "2.5.12"
  },
  "packageManager": "bun@1.4.3",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "files": [
    "src/",
    "skills/",
    "docs/",
    "examples/"
  ]
}